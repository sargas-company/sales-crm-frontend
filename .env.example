# Base URL of the backend REST API. The axios client appends paths to
# this value, so include the scheme and the leading slash of the mount
# point if any (no trailing slash).
#
# Local (Vite proxy forwards /api → http://localhost:3000):
#   VITE_API_URL=/api
# Production:
#   VITE_API_URL=https://api.sargas.io
VITE_API_URL=/api

# Public frontend origin — used by the auth link emails and
# share-link builders. No trailing slash.
#
# Local:
#   VITE_APP_URL=http://localhost:5173
# Production:
#   VITE_APP_URL=https://admin.sargas.io
VITE_APP_URL=http://localhost:5173
